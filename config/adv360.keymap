#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        /* Homerow Mods */
        hm_lgui_a: hm_lgui_a {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LGUI_A";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp A &kp LGUI>;
        };
        hm_lalt_s: hm_lalt_s {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LALT_S";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp S &kp LALT>;
        };
        hm_lctrl_d: hm_lctrl_d {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LCTRL_D";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp D &kp LCTRL>;
        };
        hm_lshft_f: hm_lshft_f {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LSHFT_F";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp F &kp LSHIFT>;
        };
        hm_rshft_j: hm_rshft_j {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_RSHFT_J";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp J &kp RSHIFT>;
        };
        hm_rctrl_k: hm_rctrl_k {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_RCTRL_K";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp K &kp RCTRL>;
        };
        hm_ralt_l: hm_ralt_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_RALT_L";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp L &kp RALT>;
        };
        hm_rgui_semicolon: hm_rgui_semicolon {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_RGUI_SEMI";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp SEMI &kp RGUI>;
        };

        /* Delete / Symbol key */
        hm_del_symbol: hm_del_symbol {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_DEL_SYMBOL";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp DEL &mo SYMBOL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================
           LAYER 0 — MAC BASE
        ========================= */
        default_layer {
            display-name = "Red";
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4       &kp N5  &to 1              &mo 3      &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T   &none               &none      &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm_lgui_a  &hm_lalt_s  &hm_lctrl_d  &hm_lshft_f  &kp G   &none     &kp LCTRL  &kp LALT  &kp LGUI  &kp RCTRL  &none  &kp H   &hm_rshft_j  &hm_rctrl_k  &hm_ralt_l  &hm_rgui_semicolon  &kp SQT
&kp LSHIFT &kp Z       &kp X       &kp C        &kp V        &kp B   &kp HOME            &kp PG_UP                        &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHIFT
&mo 2      &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT            &kp BSPC  &hm_del_symbol    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE  &kp UP       &kp DOWN     &kp LBKT    &kp RBKT  &mo 4
            >;
        };

        /* =========================
           LAYER 1 — WINDOWS BASE
        ========================= */
        win_layer {
            display-name = "Purple";
            bindings = <
                /* Use same homerow mods, adjust for Windows modifiers if needed */
&kp EQUAL  &kp N1       &kp N2      &kp N3       &kp N4       &kp N5  &to 0  &mo 3  &kp N6  &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
&kp TAB    &kp Q        &kp W       &kp E        &kp R        &kp T   &none  &none  &kp Y   &kp U &kp I &kp O &kp P &kp BSLH
&kp ESC    &hm_lctrl_d  &hm_lalt_s  &hm_lctrl_d  &hm_lshft_f &kp G &none &kp LCTRL &kp LALT &kp LGUI &kp RCTRL &none &kp H &hm_rshft_j &hm_rctrl_k &hm_ralt_l &hm_rctrl_k &kp SQT
&kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp HOME &kp PG_UP &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
&mo 2 &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT &kp BSPC &hm_del_symbol &kp END &kp PG_DN &kp ENTER &kp SPACE &kp UP &kp DOWN &kp LBKT &kp RBKT &mo 4
            >;
        };

        /* =========================
           LAYER 2 — KEYPAD
        ========================= */
        keypad {
            display-name = "Kp";
            bindings = <
/* Your keypad layer remains unchanged */
            >;
        };

        /* =========================
           LAYER 3 — FN
        ========================= */
        fn {
            display-name = "Fn";
            bindings = <
/* Your FN layer unchanged */
            >;
        };

        /* =========================
           LAYER 4 — MOD / BT / RGB
        ========================= */
        mod {
            display-name = "Mod";
            bindings = <
/* Your MOD layer unchanged */
            >;
        };

        symbol_layer {
            display-name = "Cyan";
            bindings = <
/* Symbol layer unchanged */
            >;
        };

        extra2 {
            display-name = "test";
            status = "reserved";
        };

        extra3 {
            display-name = "test2";
            status = "reserved";
        };
    };
};
