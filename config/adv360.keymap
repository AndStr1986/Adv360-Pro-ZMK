#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

/ {
    behaviors {
        os_toggle: os_toggle {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================
           LAYER 0 — MACOS BASE
           ========================= */

        mac_base {

            bindings = <
/* LEFT HALF */
&kp ESC     &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&kp TAB     &kp Q   &kp W   &kp E   &kp R   &kp T
&kp CAPS    &mt LGUI A   &mt LALT S   &mt LCTRL D   &mt LSHIFT F   &kp G
&kp LSHIFT  &kp Z   &kp X   &kp C   &kp V   &kp B

/* RIGHT HALF */
                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp Y   &kp U   &kp I   &kp O   &kp P   &kp LBKT
                &kp H   &mt RSHIFT J   &mt RCTRL K   &mt RALT L   &mt RGUI SEMI  &kp RBKT
                &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH  &kp RSHIFT

/* THUMBS */
&kp SPACE   &mo 2   &mo 3              &kp ENTER   &mo 4   &kp BSPC
            >;
        };

        /* =========================
           LAYER 1 — WINDOWS BASE
           ========================= */

        win_base {

            bindings = <
/* LEFT HALF */
&kp ESC     &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&kp TAB     &kp Q   &kp W   &kp E   &kp R   &kp T
&kp CAPS    &mt LCTRL A   &mt LALT S   &mt LCTRL D   &mt LSHIFT F   &kp G
&kp LSHIFT  &kp Z   &kp X   &kp C   &kp V   &kp B

/* RIGHT HALF */
                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp Y   &kp U   &kp I   &kp O   &kp P   &kp LBKT
                &kp H   &mt RSHIFT J   &mt RCTRL K   &mt RALT L   &mt RCTRL SEMI  &kp RBKT
                &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH  &kp RSHIFT

/* THUMBS (same layout) */
&kp SPACE   &mo 2   &mo 3              &kp ENTER   &mo 4   &kp BSPC
            >;
        };

        /* =========================
           LAYER 2 — SYMBOLS
           ========================= */

        sym_layer {
            bindings = <
&kp TILDE &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT
&trans    &kp LBRC &kp RBRC &kp PIPE &kp LT   &kp GT
&trans    &kp EQUAL &kp MINUS &kp LPAR &kp RPAR &kp AMPS
&trans    &trans    &trans    &trans    &trans    &trans

                &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDERSCORE
                &kp GRAVE &kp COLON &kp DQT  &kp BSLH &trans &trans
                &trans    &trans    &trans   &trans   &trans &trans
                &trans    &trans    &trans   &trans   &trans &trans

&trans &trans &trans     &trans &trans &trans
            >;
        };

        /* =========================
           LAYER 3 — NAVIGATION
           ========================= */

        nav_layer {
            bindings = <
&kp ESC   &kp HOME &kp UP    &kp END  &trans &trans
&kp TAB   &kp LEFT &kp DOWN  &kp RIGHT &trans &trans
&kp LCTRL &kp LGUI &kp LALT  &kp LSHIFT &trans &trans
&trans    &trans   &trans    &trans   &trans &trans

                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans

/* Bottom row — OS TOGGLE KEY HERE */
&os_toggle 1 &trans &trans    &trans &trans &trans
            >;
        };

        /* =========================
           LAYER 4 — NUMPAD
           ========================= */

        num_layer {
            bindings = <
&kp N7 &kp N8 &kp N9 &kp KP_DIVIDE &trans &trans
&kp N4 &kp N5 &kp N6 &kp KP_MULTIPLY &trans &trans
&kp N1 &kp N2 &kp N3 &kp KP_MINUS &trans &trans
&kp N0 &kp DOT &kp KP_PLUS &trans &trans &trans

                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans

&trans &trans &trans    &trans &trans &trans
            >;
        };
    };
};
